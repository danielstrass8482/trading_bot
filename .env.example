# .env.example – Template für Umgebungsvariablen
# Kopiere diese Datei zu .env und fülle die Werte aus
# WICHTIG: .env niemals in Git committen!

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Alpaca Markets (https://alpaca.markets)
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...

# Trading-Modus: PAPER oder LIVE
# PAPER = simulierter Handel ohne echtes Geld
# LIVE  = echte Orders (erst nach erfolgreicher Paper-Phase!)
TRADING_MODE=PAPER

# Alerts (optional)
ALERT_EMAIL=deine@email.de

# SMTP für E-Mail-Versand (optional – ohne diese Werte wird nur geloggt)
# Port 465 (SSL) ist Standard, da Railway Port 587 (STARTTLS) blockiert.
# SMTP_FALLBACK_PORT greift, falls auch 465 blockiert/nicht erreichbar ist.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FALLBACK_PORT=2525
SMTP_USER=absender@gmail.com
SMTP_PASSWORD=app-passwort

# Datenbank (Standard: lokale SQLite-Datei)
# Für Railway.app: wird automatisch gesetzt
DATABASE_URL=sqlite:///trading_bot.db

# Interactive Brokers (optional – nur wenn bot_config.ACTIVE_BROKER=ibkr)
# Setzt voraus, dass TWS oder IB Gateway unter IBKR_HOST erreichbar ist,
# siehe README.md "IBKR Setup". Port: 7497=TWS Paper, 7496=TWS Live,
# 4002=Gateway Paper, 4001=Gateway Live.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1

# Saxo Bank OpenAPI (LIVE) – App-Registrierung im Saxo Developer Portal.
# Access/Refresh Token werden NICHT hier gepflegt, sondern in der DB-Tabelle
# saxo_tokens (siehe saxo_client.py) – Saxo rotiert beide bei jedem Refresh.
SAXO_CLIENT_ID=...
SAXO_CLIENT_SECRET=...
SAXO_REDIRECT_URI=https://app.ai-tradingbot.de/saxo/callback

# NUR für den einmaligen initialen DB-Seed nach dem manuellen OAuth
# Authorization Code Flow (siehe database._seed_saxo_token_from_env) – danach
# aus .env wieder entfernen, sobald saxo_tokens in der DB befüllt ist.
SAXO_ACCESS_TOKEN_INITIAL=...
SAXO_REFRESH_TOKEN_INITIAL=...
SAXO_EXPIRES_IN_INITIAL=1170
SAXO_REFRESH_EXPIRES_IN_INITIAL=3570
